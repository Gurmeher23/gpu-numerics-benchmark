# CPU image: API service + benchmarks. Torch is installed from the CPU wheel index so the
# image does not pull ~2 GB of CUDA libraries it cannot use.
FROM python:3.12-slim

ARG TORCH_VERSION=2.14.1
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 \
    NUMBENCH_RUNS_DIR=/data/runs NUMBENCH_EXECUTOR=local

WORKDIR /app
RUN pip install "torch==${TORCH_VERSION}" --index-url https://download.pytorch.org/whl/cpu
COPY pyproject.toml README.md ./
COPY numbench ./numbench
# Build-time commit stamp for the run manifest (no .git inside the image).
ARG GIT_COMMIT=unknown
ENV NUMBENCH_GIT_COMMIT=${GIT_COMMIT}
RUN pip install ".[numba]"

VOLUME /data
EXPOSE 8000
CMD ["uvicorn", "numbench.api:create_app", "--host", "0.0.0.0", "--port", "8000", "--factory"]
